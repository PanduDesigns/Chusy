rules_version = '2';

// ============================================================================
// Reglas de seguridad de Firestore para Chusy.
//
// Modelo: equipo pequeño y de confianza (6-15 personas) donde TODO el
// departamento debe ver todos los proyectos y tareas — no hay privacidad
// entre compañeros dentro de la herramienta. memberIds se sigue guardando
// en cada proyecto de forma informativa (quién lo creó/participa) pero ya
// NO se usa para filtrar quién puede leer.
//
//  - meta/bootstrap: documento centinela. La primera persona en registrarse
//    lo crea y se convierte en "admin"; el resto queda como "miembro".
//  - meta/config: ajustes del equipo (p.ej. dominios de correo permitidos).
//    Solo lectura para todos, escritura solo para admins.
//  - users/{uid}: perfil de cada persona. Cualquiera autenticado puede leer
//    la lista (para asignar tareas); solo un admin puede cambiar el rol de
//    otra persona.
//  - projects/{id}: cualquier persona autenticada puede leer, crear y
//    editar cualquier proyecto. Solo quien lo creó (o un admin) puede
//    borrarlo.
//  - tasks/{id}: igual que proyectos si tienen projectId (cualquier
//    persona autenticada del equipo puede leerlas y editarlas — incluye
//    también las que solo tienen ese proyecto como ADICIONAL, ver
//    extraProjectIds en el modelo de datos, porque siguen teniendo
//    projectId relleno con su proyecto principal). Si en cambio projectId
//    es null, es una tarea PERSONAL (recordatorio sin proyecto) y solo la
//    puede leer/editar quien conste como ownerId o esté en assigneeIds —
//    se puede asignar a otras personas sin meterla en ningún proyecto,
//    desde "Mis tareas". Borrado reservado a quien la creó/es su dueño/a
//    o a un admin — estar solo en assigneeIds no basta para borrar.
//  - tasks/{id}/comments/{id}: cualquier miembro del equipo puede comentar;
//    solo el autor o un admin puede editar/borrar un comentario.
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ---- Bootstrap de administración ----
    match /meta/bootstrap {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false; // inmutable una vez creado
    }

    match /meta/config {
      // Lectura pública a propósito: solo contiene la lista de dominios de
      // correo permitidos, y hay que poder comprobarla ANTES de crear la
      // cuenta (con la persona todavía sin autenticar).
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- Usuarios ----
    match /users/{userId} {
      allow read: if isSignedIn();
      // Alta normal: cada quien crea SU PROPIO documento al registrarse. La
      // segunda rama deja que un admin cree perfiles "ficticios" para
      // personas importadas de Asana que todavía no tienen cuenta real en
      // Chusy (id propio, no un UID de Auth) — exige el flag isImported y
      // que nunca entren como admin, para que esta puerta no sirva para
      // otra cosa.
      allow create: if isSignedIn() &&
        ((request.auth.uid == userId &&
          (request.resource.data.role == 'miembro' ||
           (request.resource.data.role == 'admin' &&
            !exists(/databases/$(database)/documents/meta/bootstrap)))) ||
         (isAdmin() &&
          request.resource.data.role == 'miembro' &&
          request.resource.data.isImported == true));
      allow update: if isSignedIn() &&
        (isAdmin() || (request.auth.uid == userId && request.resource.data.role == resource.data.role));
      allow delete: if isAdmin();
    }

    // ---- Importador de Asana: mapa de equivalencias e índice de lo ya
    // importado (para que una segunda importación no duplique nada). Solo
    // lo toca el panel de administración; lectura abierta al equipo por si
    // alguna vista quiere mostrar "importado de Asana" en algo.
    match /meta/asanaUserMap {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /meta/asanaImportIndex {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---- Proyectos (visibles para todo el equipo) ----
    match /projects/{projectId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    // ---- Tareas (de proyecto: visibles para todo el equipo · personales:
    // su dueño/a y quien conste como responsable) ----
    match /tasks/{taskId} {
      // La rama "eres uno de sus responsables" es la que permite compartir
      // una tarea personal con otra persona (asignándosela desde "Mis
      // tareas") sin meterla en ningún proyecto: esa persona pasa a poder
      // leerla y editarla igual que su dueño/a, aunque no pueda borrarla
      // (ver "allow delete" más abajo, sin cambios). Esta rama en
      // concreto es la que hace que subscribeToMyTasks() (tasks.js) pueda
      // usar un único where("assigneeIds","array-contains",uid) para
      // TODA "Mis tareas" (de proyecto y personal a la vez) — antes hacía
      // falta acotar esa consulta también por projectId porque esta rama
      // todavía no existía, ver el comentario de esa función.
      allow read: if isSignedIn() &&
        (resource.data.projectId != null ||
         resource.data.ownerId == request.auth.uid ||
         (request.auth.uid in resource.data.assigneeIds) ||
         isAdmin());
      // Sin cambios respecto a antes: quien CREA una tarea siempre lo hace
      // o bien con projectId relleno (tarea de proyecto, ya abierta a todo
      // el equipo) o bien como su propia dueña/o (ownerId ==
      // request.auth.uid, tarea personal) — nunca en nombre de un tercero
      // — así que no hace falta una rama nueva aquí para poder asignar a
      // otra persona ya desde la creación: esa asignación entra en
      // assigneeIds, un campo sin restricción propia en esta regla.
      allow create: if isSignedIn() &&
        (request.resource.data.projectId != null || request.resource.data.ownerId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() &&
        (resource.data.projectId != null ||
         resource.data.ownerId == request.auth.uid ||
         (request.auth.uid in resource.data.assigneeIds) ||
         isAdmin());
      allow delete: if isSignedIn() &&
        (resource.data.ownerId == request.auth.uid ||
         resource.data.createdBy == request.auth.uid ||
         isAdmin() ||
         (resource.data.projectId != null &&
          get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.createdBy == request.auth.uid));

      match /comments/{commentId} {
        allow read: if isSignedIn();
        // Un admin puede crear un comentario a nombre de otra persona SOLO
        // para reimportar comentarios históricos de Asana con su autor
        // real; en el uso normal de la app siempre se crea con el propio
        // uid (así lo hace addComment()).
        allow create: if isSignedIn() && (request.resource.data.authorId == request.auth.uid || isAdmin());
        allow update, delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
      }
    }

    // ---- Etiquetas (vocabulario compartido: nombre + color) ----
    match /tags/{tagId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // ---- Notificaciones (reservado para la fase 2) ----
    match /notifications/{notifId} {
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
    }
  }
}
