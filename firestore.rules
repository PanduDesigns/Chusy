rules_version = '2';

// ============================================================================
// Reglas de seguridad de Firestore para Chusy.
//
// Modelo: equipo pequeño y de confianza (6-15 personas) donde TODO el
// departamento debe ver todos los proyectos y tareas — no hay privacidad
// entre compañeros dentro de la herramienta. memberIds se sigue guardando
// en cada proyecto de forma informativa (quién lo creó/participa) pero ya
// NO se usa para filtrar quién puede leer.
//
//  - meta/bootstrap: documento centinela. La primera persona en registrarse
//    lo crea y se convierte en "admin"; el resto queda como "miembro".
//  - meta/config: ajustes del equipo (p.ej. dominios de correo permitidos).
//    Solo lectura para todos, escritura solo para admins.
//  - users/{uid}: perfil de cada persona. Cualquier cuenta ACTIVA (ver
//    isActiveUser() más abajo) puede leer la lista entera (para asignar
//    tareas); solo un admin puede cambiar el rol de otra persona, su
//    departamento (campo `department`, v55 — ver más abajo), o eliminarla
//    (campo `deleted`, ver "Eliminar usuario" del panel de administración)
//    — ni el rol, ni el departamento, ni `deleted` se pueden tocar en el
//    documento propio, ni siquiera dejándolos igual que ya estaban.
//  - projects/{id}: cualquier cuenta activa puede leer, crear y editar
//    cualquier proyecto — esto incluye, desde la v55, los campos
//    `exclusive`/`exclusiveKey`/`allowedDepartments` de una "sección
//    exclusiva" como Ofertas: A PROPÓSITO no llevan una regla más estricta
//    que el resto del documento, mismo criterio que ya se usó para
//    Métricas/Revisor en la v54 — el acceso por departamento es una
//    comprobación de interfaz (ver isProjectVisibleToUser en
//    data/projects.js), no una regla de seguridad de datos. Solo quien
//    creó el proyecto (o un admin) puede borrarlo.
//  - tasks/{id}: igual que proyectos si tienen projectId (cualquier cuenta
//    activa del equipo puede leerlas y editarlas — incluye también las que
//    solo tienen ese proyecto como ADICIONAL, ver extraProjectIds en el
//    modelo de datos, porque siguen teniendo projectId relleno con su
//    proyecto principal). Si en cambio projectId es null, es una tarea
//    PERSONAL (recordatorio sin proyecto) y solo la puede leer/editar quien
//    conste como ownerId o esté en assigneeIds — se puede asignar a otras
//    personas sin meterla en ningún proyecto, desde "Mis tareas". Borrado
//    reservado a quien la creó/es su dueño/a o a un admin — estar solo en
//    assigneeIds no basta para borrar.
//  - tasks/{id}/comments/{id}: cualquier cuenta activa del equipo puede
//    comentar; solo el autor o un admin puede editar/borrar un comentario.
//  - notifications/{id}: privada — solo la lee/gestiona quien conste en
//    `userId`. Cualquier cuenta activa puede CREAR una para otra persona
//    (así avisa "te han asignado una tarea"), identificándose a sí misma
//    como `fromUserId` — no puede crear un aviso a nombre de otra.
//  - meta/quickCreate: `{enabled}` — si el botón "Nueva cabina" (apartado 3,
//    "Creación Rápida") está habilitado para todo el equipo o reservado
//    solo a administradores. Lectura para cualquier cuenta activa (el
//    topbar de cualquier proyecto necesita saberlo para pintar el botón),
//    escritura solo admin.
//  - quickCreateProducts/{id}: los "productos" que se pueden montar desde
//    "Nueva cabina" (tareas base + grupos de opciones con sus propias
//    tareas, ver apartado 3 y el modelo de datos). Lectura para cualquier
//    cuenta activa (hace falta para poder usarlos desde el botón, aunque
//    esté deshabilitado para todo el mundo salvo admins); solo un admin
//    puede crear, editar o borrar un producto — es contenido de
//    configuración del equipo, no de un proyecto concreto.
//  - meta/outlookBridge: `{key}` — la clave compartida con la macro de
//    Outlook (v61, «Conexión con Outlook»). Solo un admin la lee o la
//    cambia; borrarla apaga la conexión.
//  - meta/projectCounter y meta/projectCounter-27, -28…: `{next}` — los contadores
//    de los que sale el número de orden del ID de cada oferta y proyecto (v70,
//    XXXYY, apartado 3.14 del README): uno por año, porque el número se reinicia
//    cada año (el de 2026 es `projectCounter`; los siguientes se crean solos).
//    Los lee y los sube cualquier cuenta activa (quien crea una oferta o un
//    proyecto reparte el siguiente número, en una transacción), pero SOLO de uno
//    en uno: nada puede rebobinarlos —repetiría un ID— y nadie los borra.
//  - offerInbox/{id}: peticiones de oferta que deja la macro «Crear
//    carpeta de proyecto» de Outlook para que la pestaña de Chusy abierta
//    de su destinatario (`targetEmail`) cree la oferta (v61). Es la ÚNICA
//    colección donde se puede escribir SIN sesión iniciada — la macro la
//    usa por REST —, y por eso: (1) crear exige la clave de
//    meta/outlookBridge, con los campos y tamaños exactos; (2) solo
//    el destinatario (con sesión) puede listarlas y anotar el resultado
//    (status, claimedBy, taskId, finalName, message); (3) leer UNA por su
//    id y borrarla lo puede hacer quien la conozca — el id lo reparte
//    Firestore al crearla (20 caracteres al azar: no se adivina) y es lo que
//    usa la macro para saber si Chusy la atendió y para recogerla después;
//    listar o enumerar, no.
//  - meta/workCalendar: `{ holidays, absences, updatedBy, updatedAt }` — el
//    calendario laboral (v78, apartado 3.15 del README): los festivos de la
//    empresa/locales y las vacaciones y ausencias del equipo, en UN solo
//    documento (una escucha, una lectura). LECTURA para cualquier cuenta
//    activa (las vistas y el modal de tarea avisan de festivos y ausencias de
//    cualquier persona) y ESCRITURA solo para un admin, con la forma exacta
//    (solo esas cuatro claves, dos listas con tope de tamaño). Que cada
//    persona solo vea las ausencias de su departamento es una comprobación de
//    interfaz, como Métricas (v54/v77): el documento entero lo puede leer
//    cualquier cuenta activa. Y el contenido de cada elemento de las listas
//    (fechas, nombres) NO se puede validar desde aquí: las reglas no recorren
//    listas — lo comprueba la aplicación (work-calendar.js) al escribir.
//
// Cuentas eliminadas: "Eliminar usuario" (panel de administración) NO
// borra el documento de Firestore ni la cuenta de Firebase Auth (borrar la
// cuenta de Auth de otra persona exige el SDK de administración, con un
// backend que este proyecto no tiene) — le marca `deleted: true` a su
// perfil. isActiveUser() sustituye a un simple isSignedIn() en el resto de
// colecciones para que esa persona pierda el acceso de verdad (lectura Y
// escritura de todo salvo su propio perfil, que tampoco puede tocar), no
// solo que la propia app decida cerrarle la sesión por su cuenta — así
// tampoco le sirve de nada seguir con una sesión ya abierta desde antes de
// que se le elimine, ni usar el SDK de Firestore directamente saltándose
// la interfaz.
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Cuenta con sesión Y con perfil en `users` Y no marcada como
    // eliminada. `.get('deleted', false)` en vez de `.deleted` a secas:
    // ningún perfil anterior a esta función tiene el campo `deleted`
    // siquiera creado, y compararlo directamente haría fallar la regla
    // entera para cualquiera al que nunca le hayan tocado ese campo — con
    // el valor por defecto, "el campo no existe" se trata igual que
    // "existe y vale false" (cuenta activa).
    function isActiveUser() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('deleted', false) != true;
    }

    function isAdmin() {
      return isActiveUser() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ---- Bootstrap de administración ----
    match /meta/bootstrap {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false; // inmutable una vez creado
    }

    match /meta/config {
      // Lectura pública a propósito: solo contiene la lista de dominios de
      // correo permitidos, y hay que poder comprobarla ANTES de crear la
      // cuenta (con la persona todavía sin autenticar).
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- Usuarios ----
    match /users/{userId} {
      // Leer UN perfil (get): cualquier cuenta activa. Y, desde la v62, cada
      // persona con sesión puede pedir el SUYO aunque todavía NO exista.
      // Antes (allow read: if isActiveUser()) esa lectura se denegaba — la
      // propia isActiveUser() exige que el perfil exista —, así que quien
      // tenía cuenta de Auth pero no perfil (un registro cortado a medias)
      // recibía «permiso denegado» en vez de «no existe», y la app no podía
      // ni darse cuenta de qué faltaba ni crearlo (ver js/auth.js,
      // `onAuthChange`). Esta excepción solo cubre el documento propio y
      // solo mientras NO existe: no deja leer nada ajeno ni nada guardado
      // (una cuenta eliminada, cuyo documento sí existe, sigue sin poder
      // leerlo). Leer la LISTA de perfiles (list) sigue exigiendo cuenta activa.
      allow get: if isActiveUser() ||
        (isSignedIn() && request.auth.uid == userId &&
         !exists(/databases/$(database)/documents/users/$(userId)));
      allow list: if isActiveUser();
      // Alta normal: cada quien crea SU PROPIO documento al registrarse
      // (isSignedIn() a secas a propósito: en este mismo paso su perfil
      // todavía no existe, así que isActiveUser() sería siempre falso). La
      // segunda rama deja que un admin cree perfiles "ficticios" para
      // personas importadas de Asana que todavía no tienen cuenta real en
      // Chusy (id propio, no un UID de Auth) — exige el flag isImported y
      // que nunca entren como admin, para que esta puerta no sirva para
      // otra cosa.
      allow create: if isSignedIn() &&
        ((request.auth.uid == userId &&
          (request.resource.data.role == 'miembro' ||
           (request.resource.data.role == 'admin' &&
            !exists(/databases/$(database)/documents/meta/bootstrap)))) ||
         (isAdmin() &&
          request.resource.data.role == 'miembro' &&
          request.resource.data.isImported == true));
      // El rol, el departamento (v55) y `deleted` de un documento AJENO
      // solo los toca un admin (cubre "Administrar equipo", "Eliminar
      // usuario"/"Reactivar" y, desde la v55, el selector de departamento
      // del mismo panel). Sobre el documento PROPIO: cualquier cuenta
      // activa puede actualizar el resto de campos (nombre, tema,
      // columnas...) libremente, pero ni su propio rol, ni su propio
      // departamento, ni su propio `deleted` — ni siquiera dejándolos
      // igual que ya estaban, de ahí comparar contra el valor anterior en
      // vez de solo prohibir escribir esas claves; y una cuenta YA
      // eliminada no puede escribir nada en absoluto, ni siquiera un
      // cambio que no toque ninguna de las tres.
      allow update: if isAdmin() ||
        (isActiveUser() && request.auth.uid == userId &&
         request.resource.data.role == resource.data.role &&
         request.resource.data.get('deleted', false) == resource.data.get('deleted', false) &&
         request.resource.data.get('department', null) == resource.data.get('department', null));
      allow delete: if isAdmin();
    }

    // ---- Importador de Asana: mapa de equivalencias e índice de lo ya
    // importado (para que una segunda importación no duplique nada). Solo
    // lo toca el panel de administración; lectura abierta a cualquier
    // cuenta activa por si alguna vista quiere mostrar "importado de
    // Asana" en algo.
    match /meta/asanaUserMap {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }
    match /meta/asanaImportIndex {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    // ---- Creación Rápida: ¿el botón "Nueva cabina" está abierto a todo el
    // equipo, o reservado a admins? (apartado 3 del README) ----
    match /meta/quickCreate {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    // ---- Archivos en Google Drive (v68, apartado 3.13 del README): ¿se pueden
    // subir archivos a las tareas?, ¿a qué «puente» de Apps Script llamar? y
    // ¿cuánto pesa como máximo cada archivo? Lectura para cualquier cuenta
    // activa (cada navegador necesita la dirección del puente; no es un
    // secreto: el puente solo da permiso a quien presente una sesión activa de
    // Chusy) y escritura solo para administradores. ----
    match /meta/driveStorage {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    // ---- Calendario laboral (v78, apartado 3.15 del README): festivos y
    // ausencias del equipo en un único documento. Lectura para cualquier cuenta
    // activa; escritura solo admin y solo con esta forma: las cuatro claves
    // conocidas (`holidays` y `absences` obligatorias y de tipo lista, con un
    // tope de elementos que deja el documento muy por debajo del megabyte de
    // Firestore; `updatedBy` y `updatedAt`, opcionales). Borrarlo (volver a
    // «sin festivos ni ausencias») también es cosa de admin. ----
    match /meta/workCalendar {
      allow read: if isActiveUser();
      allow create, update: if isAdmin() &&
        request.resource.data.keys().hasAll(['holidays', 'absences']) &&
        request.resource.data.keys().hasOnly(['holidays', 'absences', 'updatedBy', 'updatedAt']) &&
        request.resource.data.holidays is list && request.resource.data.holidays.size() <= 400 &&
        request.resource.data.absences is list && request.resource.data.absences.size() <= 2000 &&
        (!('updatedBy' in request.resource.data) || request.resource.data.updatedBy == null || request.resource.data.updatedBy == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ---- ID de oferta y de proyecto (v70, apartado 3.14 del README): el contador
    // de 2026, `{ next }` (el próximo número de orden libre de ese año). Repartir
    // un ID es una transacción que lo lee y escribe `next + 1`; por eso una cuenta
    // activa puede crearlo (solo con valor 1, la primera vez) y subirlo, pero
    // únicamente de uno en uno — ni saltos ni marcha atrás: un contador que baja
    // repite IDs. ----
    match /meta/projectCounter {
      allow read: if isActiveUser();
      allow create: if isActiveUser() &&
        request.resource.data.keys().hasOnly(['next']) &&
        request.resource.data.next == 1;
      allow update: if isActiveUser() &&
        request.resource.data.keys().hasOnly(['next']) &&
        request.resource.data.next == resource.data.next + 1;
      allow delete: if false;
    }

    // ---- Los contadores de los años siguientes: `projectCounter-27`, `-28`…
    // (v71: el número de orden se reinicia cada año). Cada uno se crea solo al
    // pedir el primer ID de su año (con valor 1) y luego sube de uno en uno, igual
    // que el de 2026. El comodín solo concede algo a los documentos con ESE nombre:
    // los demás `meta/...` siguen rigiéndose por sus propios bloques. ----
    match /meta/{counterId} {
      allow read: if isActiveUser() && counterId.matches('projectCounter-[0-9][0-9]');
      allow create: if isActiveUser() && counterId.matches('projectCounter-[0-9][0-9]') &&
        request.resource.data.keys().hasOnly(['next']) &&
        request.resource.data.next == 1;
      allow update: if isActiveUser() && counterId.matches('projectCounter-[0-9][0-9]') &&
        request.resource.data.keys().hasOnly(['next']) &&
        request.resource.data.next == resource.data.next + 1;
      allow delete: if false;
    }

    // ---- Oferta desde Outlook (v61, apartado «Oferta desde Outlook» del
    // README): la clave compartida con la macro y el buzón de peticiones ----
    match /meta/outlookBridge {
      allow read, write: if isAdmin();
    }

    // v80: las dos comprobaciones del buzón de Outlook, como funciones con nombre.
    // La COLECCIÓN sigue llamándose `offerInbox` (es la que ya usan las macros
    // instaladas en los ordenadores: cambiarla las rompería).

    // Una petición nueva de la macro. Exige los siete campos de siempre (los que
    // manda CrearCarpetaProyecto.bas) y TOLERA otros siete opcionales por si alguna
    // macro instalada los manda: `createdAt` (da igual la hora del PC de quien la
    // lanza: se acepta cualquier marca de tiempo o texto, sin compararla con
    // request.time), `subject`, `localPath`, `entryId`, `senderName`,
    // `senderEmail` y `receivedAt` (texto, vacío permitido; tope de longitud).
    function validOutlookCreate() {
      return request.resource.data.keys().hasAll(['key', 'targetEmail', 'name', 'location', 'commercial', 'description', 'status']) &&
        request.resource.data.keys().hasOnly(['key', 'targetEmail', 'name', 'location', 'commercial', 'description', 'status',
          'createdAt', 'subject', 'localPath', 'entryId', 'senderName', 'senderEmail', 'receivedAt']) &&
        request.resource.data.status == 'pending' &&
        request.resource.data.targetEmail is string &&
        request.resource.data.targetEmail.size() > 2 && request.resource.data.targetEmail.size() <= 200 &&
        request.resource.data.targetEmail == request.resource.data.targetEmail.lower() &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 1000 &&
        request.resource.data.location is string && request.resource.data.location.size() <= 2000 &&
        request.resource.data.commercial is string && request.resource.data.commercial.size() <= 1000 &&
        request.resource.data.description is string && request.resource.data.description.size() <= 100000 &&
        request.resource.data.key is string &&
        (request.resource.data.get('createdAt', '') is string || request.resource.data.get('createdAt', '') is timestamp) &&
        (request.resource.data.get('receivedAt', '') is string || request.resource.data.get('receivedAt', '') is timestamp) &&
        request.resource.data.get('subject', '') is string && request.resource.data.get('subject', '').size() <= 1000 &&
        request.resource.data.get('localPath', '') is string && request.resource.data.get('localPath', '').size() <= 2000 &&
        request.resource.data.get('entryId', '') is string && request.resource.data.get('entryId', '').size() <= 1000 &&
        request.resource.data.get('senderName', '') is string && request.resource.data.get('senderName', '').size() <= 1000 &&
        request.resource.data.get('senderEmail', '') is string && request.resource.data.get('senderEmail', '').size() <= 1000 &&
        request.resource.data.key == get(/databases/$(database)/documents/meta/outlookBridge).data.key;
    }

    // El destinatario de una petición (con sesión). Compara sin distinguir
    // mayúsculas: el correo de la cuenta de Firebase Auth puede llevarlas y la
    // macro siempre manda el suyo en minúsculas. La primera comparación es la
    // de siempre (la que hace posible `list` con where('targetEmail','==',…)); la
    // segunda cubre un documento con mayúsculas guardado por otra vía.
    function isOutlookRecipient() {
      return isActiveUser() &&
        'email' in request.auth.token &&
        (resource.data.targetEmail == request.auth.token.email.lower() ||
         resource.data.targetEmail.lower() == request.auth.token.email.lower());
    }

    match /offerInbox/{requestId} {
      // Sin sesión a propósito (la macro de Outlook no inicia sesión): la
      // clave es lo que impide que cualquiera que conozca el proyecto de
      // Firebase deje peticiones. `get()` sobre un documento que no existe
      // (puente apagado) o sin `key` hace fallar la regla = denegado.
      allow create: if validOutlookCreate();

      // Una por su id (la macro mira si Chusy ya la atendió) — sin listar.
      allow get: if true;
      allow list: if isOutlookRecipient();

      // Solo la pestaña de su destinatario anota quién se la queda y cómo terminó.
      allow update: if isOutlookRecipient() &&
        request.resource.data.status in ['processing', 'created', 'error'] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'claimedBy', 'taskId', 'finalName', 'message']);

      // La macro la recoge al terminar (o la cancela si nadie la atiende);
      // el destinatario también la limpia. Lleva el texto de un correo.
      allow delete: if true;
    }

    // ---- Proyectos (visibles para todo el equipo) ----
    match /projects/{projectId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser();
      allow update: if isActiveUser();
      allow delete: if isActiveUser() && (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    // ---- Tareas (de proyecto: visibles para todo el equipo · personales:
    // su dueño/a y quien conste como responsable) ----
    match /tasks/{taskId} {
      // La rama "eres uno de sus responsables" es la que permite compartir
      // una tarea personal con otra persona (asignándosela desde "Mis
      // tareas") sin meterla en ningún proyecto: esa persona pasa a poder
      // leerla y editarla igual que su dueño/a. Desde la v41, el ownerId de
      // una tarea PERSONAL sigue a quien la lleve (ver tasks.js,
      // nextPersonalOwnerId) — así que, en el caso normal (un solo
      // responsable), esa persona también pasa a cumplir la rama de aquí
      // abajo, "resource.data.ownerId == request.auth.uid", y puede
      // borrarla igual que antes solo podía su dueño/a original. La única
      // vez que un/a responsable de una tarea personal NO puede borrarla es
      // si hay más de una persona asignada a la vez (co-asignación): el
      // ownerId se queda con quien ya lo fuera mientras esa persona siga
      // entre los responsables, así que el resto de colaboradores puede
      // leerla y editarla, pero no borrarla — solo su dueño/a, quien la
      // creó, o un admin. Esta rama en concreto es la que hace que
      // subscribeToMyTasks() (tasks.js) pueda usar un único
      // where("assigneeIds","array-contains",uid) para TODA "Mis tareas"
      // (de proyecto y personal a la vez) — antes hacía falta acotar esa
      // consulta también por projectId porque esta rama todavía no
      // existía, ver el comentario de esa función.
      allow read: if isActiveUser() &&
        (resource.data.projectId != null ||
         resource.data.ownerId == request.auth.uid ||
         (request.auth.uid in resource.data.assigneeIds) ||
         isAdmin());
      // Sin cambios respecto a antes: quien CREA una tarea siempre lo hace
      // o bien con projectId relleno (tarea de proyecto, ya abierta a todo
      // el equipo) o bien como su propia dueña/o (ownerId ==
      // request.auth.uid, tarea personal) — nunca en nombre de un tercero
      // — así que no hace falta una rama nueva aquí para poder asignar a
      // otra persona ya desde la creación: esa asignación entra en
      // assigneeIds, un campo sin restricción propia en esta regla.
      allow create: if isActiveUser() &&
        (request.resource.data.projectId != null || request.resource.data.ownerId == request.auth.uid || isAdmin());
      allow update: if isActiveUser() &&
        (resource.data.projectId != null ||
         resource.data.ownerId == request.auth.uid ||
         (request.auth.uid in resource.data.assigneeIds) ||
         isAdmin());
      allow delete: if isActiveUser() &&
        (resource.data.ownerId == request.auth.uid ||
         resource.data.createdBy == request.auth.uid ||
         isAdmin() ||
         (resource.data.projectId != null &&
          get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.createdBy == request.auth.uid));

      match /comments/{commentId} {
        allow read: if isActiveUser();
        // Un admin puede crear un comentario a nombre de otra persona SOLO
        // para reimportar comentarios históricos de Asana con su autor
        // real; en el uso normal de la app siempre se crea con el propio
        // uid (así lo hace addComment()).
        allow create: if isActiveUser() && (request.resource.data.authorId == request.auth.uid || isAdmin());
        allow update, delete: if isActiveUser() && (resource.data.authorId == request.auth.uid || isAdmin());
      }
    }

    // ---- Notificaciones (aviso al asignar una tarea) — privadas: solo
    // las lee/gestiona quien conste como destinataria (userId). Cualquier
    // cuenta activa puede CREAR una notificación para otra (así funciona
    // "te asignaron una tarea": quien asigna escribe el aviso para quien
    // recibe la tarea, no para sí misma) — la única condición es que se
    // identifique a sí misma como remitente (fromUserId), para que nadie
    // pueda suplantar de quién viene un aviso.
    match /notifications/{notifId} {
      allow read, update, delete: if isActiveUser() && resource.data.userId == request.auth.uid;
      allow create: if isActiveUser() && request.resource.data.fromUserId == request.auth.uid;
    }

    // ---- Etiquetas (vocabulario compartido: nombre + color) ----
    match /tags/{tagId} {
      allow read: if isActiveUser();
      allow write: if isActiveUser();
    }

    // ---- Creación Rápida: productos configurables (tareas base + grupos
    // de opciones, cada uno con las suyas — apartado 3 del README). Es
    // contenido de configuración del equipo, como los campos personalizados
    // o las secciones de un proyecto, pero sin proyecto propio del que
    // colgar, así que va en su propia colección de nivel superior. Lectura
    // abierta a cualquier cuenta activa (hace falta para poder USAR un
    // producto desde el botón "Nueva cabina", que cualquiera puede llegar a
    // pulsar si un admin lo habilita); solo un admin puede crear, editar o
    // borrar un producto — gestionarlos es cosa de "Creación Rápida", el
    // panel escondido en el menú de usuario.
    match /quickCreateProducts/{productId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isAdmin();
    }

    // ---- Papelera (v67): lo que se elimina se guarda aquí 30 días antes de
    // borrarse para siempre (data/trash.js, apartado 3 del README). Cada
    // documento es una copia de una tarea o de un proyecto eliminado, con quién
    // la eliminó (`deletedBy`).
    //  - Leer: cada persona SOLO lo que eliminó ella (la consulta tiene que
    //    pedir `where("deletedBy", "==", su uid)`); un admin, todo.
    //  - Crear: solo a nombre de uno mismo. Mover una tarea a la papelera es un
    //    batch que crea la copia Y borra el original, así que el permiso de
    //    borrar la tarea/proyecto sigue siendo el de siempre: si no se puede
    //    borrar el original, el batch entero falla y no se crea ninguna copia.
    //  - Borrar (eliminar para siempre, vaciar, restaurar): quien la eliminó o
    //    un admin. La purga de lo caducado la hace un admin (purgeExpiredTrash).
    //  - No se edita nunca.
    match /trash/{trashId} {
      allow read: if isActiveUser() && (resource.data.deletedBy == request.auth.uid || isAdmin());
      allow create: if isActiveUser() &&
        request.resource.data.deletedBy == request.auth.uid &&
        request.resource.data.kind in ["task", "project"];
      allow delete: if isActiveUser() && (resource.data.deletedBy == request.auth.uid || isAdmin());
      allow update: if false;
    }
  }
}
